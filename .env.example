# ============================================================
# EduGap AI Platform - Environment Configuration Example
# ============================================================

# Secret key for session security and CSRF token generation
SECRET_KEY=edugap-production-secret-token-key-2026

# Flask Environment configuration ('production' or 'development')
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# SQLite Database Location
DATABASE_PATH=database/learning_gap.db

# Optional: YouTube Data API v3 Key (if automatic video indexing is enabled)
# YOUTUBE_DATA_API_KEY=AIzaSyYourGeneratedAPIKeyHere
